[Unit]
Description=Shared PYNQ-Z2 FPGA configuration (UART, OLED IIC, buttons)
Requires=clear_pl_statefile.service
After=clear_pl_statefile.service
Before=eye-oled.service ch9329-hid.service pynq-buttons.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
Environment=XILINX_XRT=/usr
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/home/xilinx/shared_fpga
RuntimeDirectory=pynq-shared-fpga
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/share/pynq-venv/bin/python3 /opt/pynq-shared/shared_fpga.py load
# Also revoke a generation if ExecStart fails after publishing ready.
ExecStopPost=/usr/local/share/pynq-venv/bin/python3 /opt/pynq-shared/shared_fpga.py stop
TimeoutStartSec=90
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
